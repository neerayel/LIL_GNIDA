# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ)
TELEGRAM_BOT_TOKEN=""

# ID пользователей Telegram через запятую
ALLOWED_USER_IDS=[""]

# Максимальное время удержания кэша
INLINE_CACHE_TIME=30

# URL серверов в локальной сети
TARGET_SERVER=["http://host.docker.internal","5678"] #n8n вебхуки
OLLAMA_SERVER=["http://host.docker.internal","11434"]
REDIS_SERVER=["http://host.docker.internal","6379"]

# Таймаут для запросов к серверу (в секундах)
REQUEST_TIMEOUT=30

# Список доступных моделей
LLM_LIST=["gemma3:1b"]

# LLM для inline переписывания сообщений
OLLAMA_INLINE_MODEL="gemma3:1b"
# LLM для чата
OLLAMA_CHAT_MODEL="gemma3:1b"

# Кретивность модели
LLM_CREATIVITY=1.0

# Пути к файлам данных и ответов модели
OLLAMA_CHAT_INPUT_JSON_PATH="./data/LLM_CHAT_INPUT_DATA.json"
OLLAMA_SINGLE_INPUT_JSON_PATH="./data/LLM_SINGLE_INPUT_DATA.json"
LLM_RESPONSE_PATH="./data/LLM_RESPONSE_FOR_TTS.txt"

START_MESSAGE_PATH="./data/START_MESSAGE.txt"